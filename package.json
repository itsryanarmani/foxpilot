{
  "name": "foxpilot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "description": "foxpilot: a browser agent that runs entirely in Firefox, with foxmind, an on-device GLiNER2-based model (and an optional small LLM), on WebGPU",
  "type": "module",
  "bin": {
    "foxpilot": "bin/foxpilot.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "lint:ext": "node scripts/apps.mjs lint",
    "ci:local": "pnpm typecheck && pnpm test && node scripts/apps.mjs build && pnpm lint:ext",
    "e2e": "pnpm build && node scripts/e2e.mjs",
    "e2e:pii": "node scripts/build.mjs pii-guard && node apps/pii-guard/e2e/run.mjs",
    "e2e:consent": "node scripts/build.mjs consent-shield && node apps/consent-shield/e2e/run.mjs",
    "bench:firefox": "node bench/run.mjs",
    "eval": "pnpm build && node scripts/zoo/cli.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@foxpilot/agent": "workspace:*",
    "@foxpilot/core": "workspace:*",
    "@huggingface/transformers": "^4.3.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "puppeteer": "^25.16.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "web-ext": "^10.8.0"
  }
}
